# Environment - holds all credentials and API keys, never commit
.env
*.env
!.env.example

# Secrets (Docker secrets files)
secrets/*
!secrets/.gitkeep

# Runtime application data (databases, tokens, caches) - only keep
# hand-written config templates under version control
appdata/*
!appdata/.gitkeep
!appdata/homepage/
appdata/homepage/*
!appdata/homepage/*.yaml
!appdata/dnsmasq/
appdata/dnsmasq/*
!appdata/dnsmasq/dnsmasq.conf
!appdata/loki/
appdata/loki/*
!appdata/loki/loki-config.yaml
!appdata/alloy/
appdata/alloy/*
!appdata/alloy/config.alloy
!appdata/prometheus/
appdata/prometheus/*
!appdata/prometheus/prometheus.yml
!appdata/grafana/
appdata/grafana/*
!appdata/grafana/provisioning/

# OS noise
.DS_Store
