# ===================================================================
# Docker Media Server - environment template
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored - NEVER commit it, it holds all your credentials.
# ===================================================================

# Activate all service profiles so `docker compose up -d` starts everything
COMPOSE_PROFILES=all

# ------------------------- Host & paths ---------------------------
# Absolute path to this repository on the host
DOCKERDIR=/home/YOUR_USER/media-server
# Media library, downloads, and the folder exposed by File Browser
MEDIADIR=/mnt/media
DOWNLOADSDIR=/mnt/downloads
USERDIR=/home/YOUR_USER
# Extra media folders (only if you uncomment them in the compose files)
#MEDIADIR2=
#MEDIADIR3=

TZ=Europe/Bratislava
# Run `id` to get these
PUID=1000
PGID=1000

# ----------------------- Network & local DNS ----------------------
# LAN IP of this host (the minipc)
HOST_IP=192.168.1.245
SERVER_LAN_IP=192.168.1.245
# Networks allowed to access Plex without authentication
LOCAL_IPS=192.168.1.0/24
# Domain for all service URLs: http://<name>.$LOCAL_DOMAIN via Traefik.
# This is a public DuckDNS record pointing at the PRIVATE LAN IP above, so
# every LAN device resolves it without any router/device DNS changes.
# Keep it in sync with appdata/dnsmasq/dnsmasq.conf and the duckdns.org
# record if you change it.
LOCAL_DOMAIN=janba-minipc.duckdns.org

# --------------------------- Ports --------------------------------
HOMEPAGE_PORT=3000
PLEX_PORT=32400
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
SEERR_PORT=5055
QBITTORRENT_PORT=8080
FLARESOLVERR_PORT=8191
DOZZLE_PORT=8082
FILEBROWSER_PORT=8083
PORTAINER_PORT=9000
GRAFANA_PORT=3001
SABNZBD_PORT=8081
# Disabled services
#BAZARR_PORT=6767
#TDARR_PORT=8265
#TDARR_WEBUI_PORT=8266
#N8N_PORT=5678

# --------------------------- Plex ---------------------------------
PLEX_SERVER_NAME=minipc
# Put your claim code from https://plex.tv/claim into secrets/plex_claim
# (file, not env var). Optional X-Plex-Token for the homepage widget:
#PLEX_API_KEY=

# ---------------- Homepage widget credentials ---------------------
# Fill these in AFTER first-run setup of each app (Settings -> General
# -> API Key in the *arr apps, WebUI credentials for qBittorrent).
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
SEERR_API_KEY=
PORTAINER_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# Stock ticker on the dashboard (https://finnhub.io)
FINNHUB_API_KEY=

# ----------------------- Remote access ----------------------------
# Optional Tailscale auth key (admin console -> Settings -> Keys) for
# non-interactive join. Leave empty to authenticate via the login URL
# printed in `docker logs tailscale` on first start.
TS_AUTHKEY=
# Tailscale API access token for the homepage widget (admin console ->
# Settings -> Keys -> API access tokens). Expires after <=90 days;
# regenerate when the widget stops showing data.
TAILSCALE_API_KEY=

# -------------- Disabled services (n8n + postgres + redis) --------
# Uncomment their includes in docker-compose.yml first.
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=
#POSTGRES_DB=postgres
#POSTGRES_MULTIPLE_DATABASES=n8n
#POSTGRES_N8N_PASSWORD=
#N8N_HOST=n8n.janba-minipc.duckdns.org
